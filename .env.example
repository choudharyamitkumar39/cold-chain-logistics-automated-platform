# ================================================================
# FDE Cold-Chain Logistics AI Assistant - Environment Variables
# ================================================================

# --- Gemini API Configuration ---
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --- Agent & Embeddings Provider Selection ---
# Options for AGENT_LLM: GEMINI (default), OPENAI, DEEPSEEK, OLLAMA
AGENT_LLM=GEMINI
# Options for EMBEDDINGS_MODEL: GEMINI (default), OPENAI, LOCAL
EMBEDDINGS_MODEL=GEMINI

# --- Pinecone Vector Database ---
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=fde-sop-index-gemini

# --- Microsoft SQL Server (Docker or Cloud) ---
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_DATABASE=master

# Administrator Credentials (Used for Data Ingestion & Audit Log Admin)
SQL_ADMIN_USER=sa
SQL_ADMIN_PASSWORD=FdeEnterprisePass123!

# Agent Least-Privilege Credentials (Read-only on FDE_VIEWS)
SQL_AGENT_USER=USR_FDE_RO
SQL_AGENT_PASSWORD=AgentPassword2026!

# --- Optional Cloud Backups ---
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
